# ---------------------------------------------------------------------------
# KEMTA SUIVI — variables d'environnement
# Copiez ce fichier en `.env` et remplacez toutes les valeurs sensibles.
# Aucun secret ne doit jamais être commité.
# ---------------------------------------------------------------------------

# --- Django ---
DJANGO_ENV=local                 # local | test | production
DEBUG=true
SECRET_KEY=changez-cette-valeur-en-production
APP_VERSION=0.1.0
TIME_ZONE=Africa/Douala
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
EXTRA_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Base de données ---
# En local (hors Docker), utilisez USE_SQLITE=true pour démarrer sans PostgreSQL.
USE_SQLITE=false
DATABASE_URL=postgres://kemta:kemta@db:5432/kemta

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
USE_LOCAL_CACHE=false
CELERY_TASK_ALWAYS_EAGER=false

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Politique de mot de passe ---
PASSWORD_MIN_LENGTH=10

# --- Téléphone (identifiant principal) ---
PHONE_ALLOWED_REGIONS=CM

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT_PER_PHONE=3
OTP_RESEND_LIMIT_PER_IP=10
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# --- Rate limiting (format DRF : "10/min", "20/hour") ---
THROTTLE_OTP_REQUEST=20/hour
THROTTLE_PASSWORD_RESET=20/hour
THROTTLE_LOGIN=10/min
THROTTLE_SENSITIVE=60/hour
THROTTLE_ANON=60/min
THROTTLE_USER=2000/hour
THROTTLE_UPLOAD=240/hour        # envois de fichiers (preuves, justificatifs), par utilisateur
THROTTLE_SYNC=600/hour          # synchronisation hors ligne, par utilisateur
# Nombre de reverse proxies de confiance devant l'application (0 en local, 1 derrière Nginx).
# Sans cela, X-Forwarded-For est ignoré : un client ne peut pas usurper son IP.
NUM_PROXIES=0

# --- Notifications, tâches et rétention (phase 10) ---
DASHBOARD_CACHE_SECONDS=60      # cache du dashboard ; invalidé à chaque écriture, 0 = désactivé
NOTIFICATION_RETENTION_DAYS=90  # les notifications LUES sont purgées après ce délai
TASK_RUN_RETENTION_DAYS=14      # suivi des tâches Celery (les échecs sont gardés 4 fois plus)
TEMP_FILE_MAX_AGE_HOURS=24      # nettoyage de MEDIA_ROOT/tmp
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180

# --- Observabilité (phase 11) ---
METRICS_BACKEND=memory          # redis (production : partagé entre workers) | memory
# Jeton du scraper Prometheus (Authorization: Bearer …). Vide = endpoint réservé aux admins.
# Générez-le : python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
SLOW_REQUEST_SECONDS=1.5        # au-delà, la requête est journalisée comme lente
# Suivi d'erreurs facultatif (aucune donnée personnelle envoyée).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Fournisseur SMS (voir ADR-005) ---
SMS_PROVIDER=console            # console (dev/test) | real (production)
SMS_API_KEY=
SMS_SENDER_ID=KEMTA

# --- Email (ajout facultatif, vérification, réinitialisation de secours) ---
EMAIL_BACKEND_PROVIDER=console  # console (dev/test) | smtp
DEFAULT_FROM_EMAIL=no-reply@kemta.cm
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Médias ---
MEDIA_STORAGE=local             # local | s3
MEDIA_ROOT=/app/var/media
STATIC_ROOT=/app/var/static
MAX_UPLOAD_SIZE_MB=10

# --- Sécurité production ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
MEDIA_X_ACCEL_REDIRECT=false    # true en production : Nginx envoie les fichiers après contrôle d'accès
TLS_CERTS_DIR=./certs           # dossier contenant fullchain.pem et privkey.pem (jamais versionné)
HTTPS_PORT=443

# --- Frontend (build) ---
VITE_API_TARGET=http://web:8000
